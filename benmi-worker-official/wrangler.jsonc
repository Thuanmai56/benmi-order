{
  "name": "benmi-worker-official",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-03-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    {
      "id": "4800c4ce106043de89baa2aa7a7676b0",
      "binding": "ORDER_STATE"
    }
  ],
  "vars": {
    "LIFF_ID": "2009560906-c5taZfiY",
    "LIFF_URL": "https://liff.line.me/2009560906-c5taZfiY"
  },
  "secrets_store_secrets": [
    {
      "binding": "LINE_CHANNEL_TOKEN",
      "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
      "secret_name": "LINE_MESSAGE_API_CHANNEL_BENMI"
    },
    {
      "binding": "OPENROUTER_API_KEY",
      "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
      "secret_name": "OPENROUTER_API_KEY_BENMI"
    },
    {
      "binding": "GROQ_API_KEY",
      "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
      "secret_name": "GROQ_API_KEY_BENMI"
    }
  ],
  "env": {
    "test": {
      "name": "spring-smoke-46ba", // test worker
      "vars": {
        "LIFF_ID": "2009555608-DMioljsI",
        "LIFF_URL": "https://liff.line.me/2009555608-DMioljsI"
      },
      "secrets_store_secrets": [
        {
          "binding": "LINE_CHANNEL_TOKEN",
          "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
          "secret_name": "LINE_MESSAGE_API_CHANNEL_BLAB"
        },
        {
          "binding": "OPENROUTER_API_KEY",
          "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
          "secret_name": "OPENROUTER_API_KEY_BLAB"
        },
        {
          "binding": "GROQ_API_KEY",
          "store_id": "7e2896f1c5cf4e1eb80ef6c89f3024d4",
          "secret_name": "GROQ_API_KEY_BLAB"
        }
      ],
      "kv_namespaces": [
        {
          "id": "ad5b1e14aad4486fb2ffcd9961cadf3a",
          "binding": "ORDER_STATE"
        }
      ]
    },
    "dev": {
      "name": "benmi-order-worker-dev",
      "kv_namespaces": [
        {
          "id": "ad5b1e14aad4486fb2ffcd9961cadf3a",
          "binding": "ORDER_STATE"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blab-db-dev",
          "database_id": "40b67d8a-29e0-40c1-9ce2-b76f76864e95"
        }
      ]
    }
  }
}