{
  "name": "benmi-worker-official",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-03-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    {
      "id": "4800c4ce106043de89baa2aa7a7676b0",
      "binding": "ORDER_STATE"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blab-db-production",
      "database_id": "48479f91-eec7-4da2-b044-edaaf622f195"
    }
  ],
  "env": {
    "test": {
      "name": "spring-smoke-46ba", // test worker
      "kv_namespaces": [
        {
          "id": "ad5b1e14aad4486fb2ffcd9961cadf3a",
          "binding": "ORDER_STATE"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blab-db-test",
          "database_id": "c0152835-7d42-4545-8cb4-6658dfc7e97d"
        }
      ]
    },
    "dev": {
      "name": "benmi-order-worker-dev",
      "kv_namespaces": [
        {
          "id": "ad5b1e14aad4486fb2ffcd9961cadf3a",
          "binding": "ORDER_STATE"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blab-db-dev",
          "database_id": "40b67d8a-29e0-40c1-9ce2-b76f76864e95"
        }
      ]
    }
  }
}