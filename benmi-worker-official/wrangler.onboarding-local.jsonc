{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blab-platform-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ONBOARDING_ENABLED": "true",
    "ONBOARDING_CUSTOMER_BASE_URL": "http://127.0.0.1:8080",
    "ONBOARDING_PLATFORM_BASE_URL": "http://127.0.0.1:8788",
    "ONBOARDING_STAFF_ROLES": "{\"developer@localhost\":[\"draft:edit\",\"tenant:publish\",\"credential:manage\"]}"
  },
  "kv_namespaces": [{ "binding": "ORDER_STATE", "id": "local-onboarding-kv" }],
  "d1_databases": [{ "binding": "DB", "database_name": "blab-onboarding-local", "database_id": "local-onboarding-db", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
